{
    "name": "senebridge/senebridge",
    "description": "Plateforme digitale de gestion et de suivi des clients, biens et projets",
    "type": "project",
    "license": "proprietary",
    "keywords": ["senebridge", "senegal", "gestion", "projets", "clients"],
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-sodium": "*",
        "symfony/uid": "^6.4",
        "monolog/monolog": "^3.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.30"
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "migrate": "php public/index.php migrate",
        "seed": "php public/index.php seed"
    }
}